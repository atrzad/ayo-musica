# Copie para .env (permissão 600). Só localhost; o Tailscale publica (deploy/tailscale).
PORT=3600
# Client IDs OAuth do Google Cloud aceitos: o "Web" (usado pelo app Android) e o "Desktop", separados por vírgula.
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
# E-mails Google que podem entrar, separados por vírgula.
ALLOWED_EMAILS=glwydsond@gmail.com
# DATA_DIR=/home/ayo/.local/share/ayo-musica-sync
# Pastas de música deste PC indexadas na nuvem de uma conta (sem copiar): email=/caminho;email2=/outro
LIBRARY_FOLDERS=glwydsond@gmail.com=/home/ayo/Music
