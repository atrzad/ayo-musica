<?xml version="1.0" encoding="utf-8"?>
<!-- Playlists, lyrics delays and the saved queue go to the Android backup; covers are re-read from the files. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <exclude domain="file" path="lyrics" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
